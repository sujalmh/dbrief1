# F1 AI Chatbot - Environment Variables
# ======================================
# Copy this file to .env.local and fill in your API keys

# =============================================================================
# Managed AI model (the ONLY server model — OpenCode Go, MiMo V2.5).# Users pick nothing; "Setup by me" mode in Settings just works when
# one of these keys is set. Everyone else uses BYOK (own key + endpoint
# in Settings, stored in an httpOnly cookie).
# =============================================================================

# Preferred names (override model + URL without a deploy):
# MANAGED_LLM_MODEL=mimo-v2.5
# MANAGED_LLM_BASE_URL=https://opencode.ai/zen/go/v1
# MANAGED_LLM_API_KEY=

# Legacy fallback (kept working): OpenCode Go key, https://opencode.ai/docs/go
OPENCODE_GO_API_KEY=

# =============================================================================
# Cloudflare storage (sessions, messages, blobs) — replaces Firebase
# D1 database `f1-sessions` + R2 bucket `f1-ai` are already provisioned.
# Create ONE API token (dash: My Profile > API Tokens > Create Custom Token):
#   - D1 Edit (Account, this account)
#   - Workers R2 Storage Bucket Item Write, scoped to bucket `f1-ai`
# Then paste it below and restart. Without it the app runs local-only
# (IndexedDB) and /api/cf/health reports configured:false.
# =============================================================================

CF_ACCOUNT_ID=7fb30c62368164d849d8ca1a5d28ed19
CF_API_TOKEN=
CF_D1_DATABASE_ID=c5acda92-8b2c-4daf-a004-e4f7cc1f0179
CF_R2_BUCKET=f1-ai

# =============================================================================
# Free-tier quotas (everyone metered, BYOK looser). All optional — code
# defaults shown. Kill-switch: QUOTAS_ENABLED=false. Admin bypass: ADMIN_UIDS
# (comma-separated cf_uid values; find yours at GET /api/cf/me).
# IP caps are tier-agnostic ≈ 2x the free account share (household/CGNAT).
# =============================================================================

QUOTAS_ENABLED=true
IP_HASH_SALT=
MANAGED_DAILY_CAP_USD=5
ADMIN_UIDS=
# QUOTA_FREE_QUERIES=20
# QUOTA_FREE_DEEP=3
# QUOTA_FREE_SIM=3
# QUOTA_FREE_SIM_ITER=2000
# QUOTA_FREE_OUT_TOKENS=150000
# QUOTA_BYOK_QUERIES=100
# QUOTA_BYOK_DEEP=10
# QUOTA_BYOK_SIM=20
# QUOTA_BYOK_SIM_ITER=5000
# QUOTA_BYOK_OUT_TOKENS=1000000
# QUOTA_IP_QUERIES=40
# QUOTA_IP_DEEP=6
# QUOTA_IP_SIM=6
# QUOTA_IP_OUT_TOKENS=300000
# QUOTA_IP_MAX_ACCOUNTS=10
# QUOTA_IP_MAX_SESSIONS=30
# QUOTA_DEEP_QUERY_WEIGHT=5
# MODEL_PRICES_JSON={"my-model": [1.5, 6.0]}

# =============================================================================
# Direct Google OAuth ("Sign in with Google", no Firebase).
# Console: console.cloud.google.com → APIs & Services → Credentials →
#   Create Credentials → OAuth client ID → Web application.
#   Authorized redirect URIs must include (exact match):
#     https://<your-prod-domain>/api/auth/callback
#     http://localhost:3000/api/auth/callback   (local dev)
#   (First-time setup also needs the OAuth consent screen: External,
#   app name + support email. Test mode is fine to start.)
# Leave both empty to hide the sign-in button (passwordless mode).
# Optional: GOOGLE_OAUTH_REDIRECT_URI pins one callback URL instead of
# deriving it per request (useful behind rewrites/proxies).
# =============================================================================

# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

# Signs the cf_uid session cookie (HMAC-SHA256). Generate with:
#   openssl rand -base64 32
# Required in production; without it cookies are unsigned (dev only).
CF_SESSION_SECRET=

# =============================================================================
# F1 API Service
# =============================================================================

# URL of the FastAPI microservice
# Default: http://localhost:8000 for local development
F1_API_URL=http://localhost:8000

# Shared secret for the FastAPI backend (must match api's F1_API_KEY).
# Set in production; when empty the backend accepts unauthenticated calls.
F1_API_KEY=

# =============================================================================
# =============================================================================
# Qdrant (for RAG retrieval)
# =============================================================================

QDRANT_URL=
QDRANT_API_KEY=

# =============================================================================
# Voyage AI by MongoDB (for query embeddings + reranking)
# https://www.mongodb.com/docs/voyageai/models/text-embeddings/
# =============================================================================

# Model API key used for voyage-4 embeddings and rerank-3 reranking
EMBEDDINGS_API_KEY=

# =============================================================================
# TinyFish web search (https://docs.tinyfish.ai/search-api) — free on every
# plan. Powers the `web_search` tool for news/current events. Without the
# key the tool reports itself unconfigured (no crash, just no web results).
# =============================================================================

# TINYFISH_API_KEY=
# TINYFISH_BASE_URL=https://api.search.tinyfish.ai
# TINYFISH_TIMEOUT_MS=15000
# TINYFISH_RESULTS_LIMIT=5
