# F1 AI Chatbot - Environment Variables
# ======================================
# Copy this file to .env.local and fill in your API keys

# =============================================================================
# LLM Providers (at least one required)
# =============================================================================

# Google AI (Gemini) - https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face - https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# =============================================================================
# OpenCode Zen (free + pay-as-you-go models) - https://opencode.ai/docs/zen/
# Sign in at https://opencode.ai/auth, copy your API key.
# Either set it here or paste it in the app's Settings ("Team Access Key").
# =============================================================================

OPENCODE_ZEN_API_KEY=

# =============================================================================
# OpenCode Go ($10/mo coding models) - https://opencode.ai/docs/go
# Subscribe at https://opencode.ai/auth, copy your API key.
# Either set it here or paste it in the app's Settings ("Team Access Key").
# =============================================================================

OPENCODE_GO_API_KEY=

# =============================================================================
# F1 API Service
# =============================================================================

# URL of the FastAPI microservice
# Default: http://localhost:8000 for local development
F1_API_URL=http://localhost:8000

# =============================================================================
# =============================================================================
# Qdrant (for RAG retrieval)
# =============================================================================

QDRANT_URL=
QDRANT_API_KEY=

# =============================================================================
# Voyage AI by MongoDB (for query embeddings + reranking)
# https://www.mongodb.com/docs/voyageai/models/text-embeddings/
# =============================================================================

# Model API key used for voyage-4 embeddings and rerank-3 reranking
EMBEDDINGS_API_KEY=

# =============================================================================
# Dynamic configuration (all optional — defaults preserve current behavior)
# See main/lib/config.ts for the full list. Uncomment to override.
# =============================================================================

# --- Seasons / data availability ---
# F1_MIN_SEASON_YEAR=1950
# F1_SEASON_YEAR_BUFFER=2
# F1_TELEMETRY_START_YEAR=2018
# F1_RAG_MAX_SEASON_YEAR=2100

# --- Execution ---
# F1_STEP_TIMEOUT_MS=30000
# F1_MAX_CONCURRENCY=6
# F1_MAX_RETRIES=1
# F1_RETRY_BACKOFF_BASE_MS=400
# F1_MAX_CONTEXT_TOKENS=150000
# F1_MAX_ROWS_PER_LIST=12

# --- Planner ---
# F1_PLANNER_MAX_STEPS=5
# F1_PLANNER_DEEP_MAX_STEPS=25
# F1_PLANNER_MAX_TASKS_PER_ITERATION=6

# --- LLM timeouts (ms) ---
# LLM_TIMEOUT_INTENT_MS=15000
# LLM_TIMEOUT_PLANNER_MS=45000
# LLM_TIMEOUT_RESPONDER_MS=180000
# LLM_TIMEOUT_SOURCES_MS=8000
# LLM_TIMEOUT_CRITIC_MS=10000

# --- LLM sampling / budgets ---
# LLM_TEMPERATURE_DEFAULT=0.7
# LLM_MAX_TOKENS_RESPONDER=8192

# --- Provider catalog (JSON array merged by id; adds models/providers) ---
# F1_PROVIDERS_JSON=[{"id":"openrouter","models":[{"id":"my-model","label":"My Model"}]}]

# --- F1 reference data (JSON overrides; see lib/reference-data.ts) ---
# F1_DRIVERS_JSON=["VER","HAM"]
# F1_DRIVER_ALIASES_JSON={"max verstappen":"VER"}
# F1_GP_NAMES_JSON=["Monaco"]
# F1_GP_PATTERNS_JSON=[{"match":"monaco","name":"Monaco"}]

# --- RAG retrieval ---
# RAG_MIN_RELEVANCE_SCORE=0.2
# RAG_TOP_N_RESULTS=5
# RAG_MAX_SUBQUERIES=5

# --- Research loop ---
# RESEARCH_OVERALL_TIMEOUT_MS=300000
# RESEARCH_DEFAULT_MAX_TASKS=50
# RESEARCH_DEFAULT_MAX_ITERATIONS=20
# RESEARCH_DEEP_MAX_TASKS=15
# RESEARCH_DEEP_MAX_ITERATIONS=6

# --- Chat route ---
# CHAT_RATE_LIMIT_WINDOW_MS=60000
# CHAT_RATE_LIMIT_MAX=20
# CHAT_MESSAGE_MAX_CHARS=4000

# --- System prompt override ---
# F1_RESPONDER_SYSTEM_PROMPT=...
